; Engine configuration file.
config_version=5

[application]
config/name="AirOrbArena"
run/main_scene="res://scenes/Main.tscn"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[input]
move_forward={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":87}]}
move_back={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":83}]}
move_left={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":65}]}
move_right={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":68}]}
jump={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":32}]}
cast_orb={"deadzone":0.2,"events":[{"type":"InputEventMouseButton","button_index":1}]}
host_game={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":112}]}
join_game={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":113}]}
disconnect_game={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":114}]}
toggle_debug={"deadzone":0.2,"events":[{"type":"InputEventKey","physical_keycode":114,"shift_pressed":true}]}

[physics]
common/physics_ticks_per_second=60

[rendering]
environment/defaults/default_environment="res://scenes/WorldEnvironment.tres"
anti_aliasing/quality/msaa_3d=2
glow/enabled=true
